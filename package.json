{
  "name": "onlycampus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node --watch backend/server.js",
    "client": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "db:init": "node database/init.js",
    "test": "node --test",
    "db:migrate": "node database/migrate.js",
    "admin:create": "node database/create-admin.js",
    "db:demo-admin": "node database/demo-operations.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "marked": "^15.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
